[Unit]
Description=BlockPools Bain-3 -- morning preview price of today's NBA games (never trades)
After=network-online.target

[Service]
# Prices every game 2-30h out once, so the ops monitor shows a preliminary
# fair price and data gaps before the 2h pricing window. Cannot trade: every
# game it sees is outside the 45-minute trading window.
Type=oneshot
User=bp
WorkingDirectory=/opt/blockpools/backend
Environment=TRADING_BOT_CONFIG=config.bain-3.json
ExecStart=/usr/bin/node trading-bot/run/tick-nba.js --preview
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-bain-preview
