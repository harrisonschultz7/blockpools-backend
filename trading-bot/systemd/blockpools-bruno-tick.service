[Unit]
Description=BlockPools Bruno-7 -- QB passing-yards forecast + paper trade tick
After=network-online.target

[Service]
# PATH NOTE: WorkingDirectory/User MUST match the existing backend unit.
# Confirm with:  systemctl cat blockpools-backend.service
Type=oneshot
User=bp
WorkingDirectory=/opt/blockpools/backend
# run/tick-passing.js calls selectConfig("config.bruno-7.json") itself; the env
# var is the belt to those braces, as on the Argo-7 tick.
Environment=TRADING_BOT_CONFIG=config.bruno-7.json
ExecStart=/usr/bin/node trading-bot/run/tick-passing.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-bruno-tick
