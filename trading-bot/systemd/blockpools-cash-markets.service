[Unit]
Description=BlockPools Cash-7 -- discover NFL passing-yards prop markets
After=network-online.target

[Service]
Type=oneshot
User=bp
WorkingDirectory=/opt/blockpools/backend
Environment=TRADING_BOT_CONFIG=config.argo-7.json
ExecStart=/usr/bin/node trading-bot/run/ingest-passing-markets.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-cash-markets
