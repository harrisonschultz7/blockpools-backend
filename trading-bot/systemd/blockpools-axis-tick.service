[Unit]
Description=BlockPools Axis-3 -- NBA moneyline forecast + paper trade tick
After=network-online.target

[Service]
# PATH NOTE: WorkingDirectory/User MUST match the existing backend unit.
# Confirm with:  systemctl cat blockpools-backend.service
Type=oneshot
User=bp
WorkingDirectory=/opt/blockpools/backend
# run/tick-nba.js selects config.axis-3.json itself; the env var is the belt
# to those braces, as on the other ticks.
Environment=TRADING_BOT_CONFIG=config.axis-3.json
ExecStart=/usr/bin/node trading-bot/run/tick-nba.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-axis-tick
