[Unit]
Description=Run the Axis-3 NBA morning preview daily

[Timer]
# 14:00 UTC = 9am US-Eastern (10am during daylight time). Axis-3 runs first: it refreshes ESPN (schedule, injuries) that Bain-3 then reads.
OnCalendar=*-*-* 14:00:00 UTC
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
