[Unit]
Description=BlockPools Axis-3 -- Polymarket NBA moneyline depth recorder + exit/stop sweep
After=network-online.target
Wants=network-online.target

[Service]
# PATH NOTE: WorkingDirectory/User MUST match the existing backend unit.
Type=simple
User=bp
WorkingDirectory=/opt/blockpools/backend
Environment=TRADING_BOT_CONFIG=config.axis-3.json
ExecStart=/usr/bin/node trading-bot/run/record-books-nba.js
Restart=always
RestartSec=5
# Book depth cannot be backfilled from anywhere; never give up restarting.
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-axis-recorder

[Install]
WantedBy=multi-user.target
